// libpng 1.2.x as a static library for S60 3rd Edition FP1 (GCCE)
TARGET        lpng.lib
TARGETTYPE    lib

SYSTEMINCLUDE \epoc32\include \epoc32\include\stdapis
USERINCLUDE   ..

SOURCEPATH    ..
SOURCE png.c pngerror.c pngget.c pngmem.c pngpread.c pngread.c pngrio.c
SOURCE pngrtran.c pngrutil.c pngset.c pngtrans.c pngwio.c pngwrite.c
SOURCE pngwtran.c pngwutil.c
