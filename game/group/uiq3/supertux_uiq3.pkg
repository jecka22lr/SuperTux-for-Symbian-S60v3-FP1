;;;
;;; SuperTux.PKG file for .SIS gegeration
;;;


; List of localised vendor names - one per language. At least one must be provided (English [EN]).
; List must correspond to list of languages specified elsewhere in the .pkg
%{"SomeOne"}
; The non-localised, globally unique vendor name (mandatory)
:"SomeOne"

; UID is the app's UID
#{"SuperTux"},( 0xA000A003),0,10,3

; ProductID for UIQ 3.0
; Product/platform version UID, Major, Minor, Build, Product ID
(0x101F6300), 3, 0, 0, {"UIQ30ProductID"}


;@"pips_uiq_1_2.sis", (0x20009A81)

; Application, AIF & Resource file
"\epoc32\release\gcce\urel\SuperTux.exe"-		"!:\sys\bin\SuperTux.exe"
"\epoc32\data\z\resource\apps\SuperTux.rsc"-	"!:\resource\apps\SuperTux.rsc"
"\epoc32\data\Z\resource\APPS\SuperTux.mbm"-	"!:\resource\apps\SuperTux.mbm"
"\epoc32\data\z\private\10003a3f\apps\SuperTux_reg.rsc"-"!:\private\10003a3f\import\apps\SuperTux_reg.rsc"

; Readmes on screen
"..\..\AUTHORS"-"c:\shared\supertux\AUTHORS", FT, TC
"..\..\README"-"c:\shared\supertux\README", FT, TC
"..\..\COPYING"-"c:\shared\supertux\COPYING", FT, TC

; Config/log files: 'empty' will automagically be removed on uninstall

""-"c:\shared\SuperTux\sdl.ini",FILENULL
""-"c:\shared\SuperTux\Config",FILENULL
""-"c:\shared\SuperTux\save\slot1.stsg",FILENULL
""-"c:\shared\SuperTux\save\slot2.stsg",FILENULL
""-"c:\shared\SuperTux\save\slot3.stsg",FILENULL
""-"c:\shared\SuperTux\save\slot4.stsg",FILENULL
; This install layout will let you upgrade to newer versions wihout loss of SuperTux.ini.
; It will remove the config file, std***.txt files & dirs on uninstall.

